---
import { PHOTOS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import ScreenTimeline from '~/components/screens/ScreenTimeline.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import { ScreensList } from '~/lib/screens'

const { title, description, introduce } = PHOTOS_CONFIG
---

<Layout {title} {description} disableViewTransition>
  <div class="relative z-[1] py-8 pb-10 px-6 sm:px-8">
    <PageTitle {title} {introduce} />
    <div class="mt-12">
      {
        ScreensList.length > 0 ? (
          <ScreenTimeline screenData={ScreensList} />
        ) : (
          <div class="text-muted-foreground mb-4">
            <p class="text-sm">No screenshots yet.</p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
